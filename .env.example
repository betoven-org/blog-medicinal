# Brasa CMS — Variaveis de Ambiente
# Rode: pnpm init:env (cria .env.local com secrets gerados)

# ─── Obrigatorias ────────────────────────────────────────────

# Banco de dados (Neon PostgreSQL)
DATABASE_URI="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# URL publica do site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Tenant (slug do tenant no banco)
BRASA_TENANT_SLUG=""

# Metricas (secret interno)
METRICS_INGEST_SECRET=""

# Revalidacao de cache
REVALIDATE_SECRET=""

# ─── Supabase (sync de midia) ────────────────────────────────

SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_WEBHOOK_SECRET=""

# ─── Vercel (admin: dominios e env vars) ─────────────────────

VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""

# ─── Analytics (dashboard admin) ─────────────────────────────

# ANALYTICS_TOKEN=""
# ANALYTICS_PROJECT_ID=""
# ANALYTICS_TEAM_ID=""

# ─── Stripe (assinaturas, opcional) ──────────────────────────

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ─── Cron jobs ───────────────────────────────────────────────

# CRON_SECRET=""
